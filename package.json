{
  "name": "eino-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Book and movie tracker with web and Android clients",
  "license": "MIT",
  "author": "Jankku",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jankku/eino-backend.git"
  },
  "main": "./dist/app.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npx tsc",
    "start": "npm run build && node ./dist/src/app.js",
    "dev": "node -r ts-node/register --watch-path=src src/app.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src migrations",
    "lint:fix": "oxlint --fix src migrations",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js",
    "migrate:dev": "npm run migrate -- -m dist/migrations",
    "prepare": "husky"
  },
  "dependencies": {
    "@epic-web/cachified": "^5.6.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fi": "^4.1.1",
    "argon2": "0.45.1",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "close-with-grace": "^2.5.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "mailtrap": "^6.0.0",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "otpauth": "^9.5.2",
    "pg-monitor": "^3.1.0",
    "pg-promise": "^12.7.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "node-gyp": "^13.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pin-github-action": "^3.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "canvas@3.2.3": true,
    "@scarf/scarf": false,
    "unrs-resolver@1.12.2": true,
    "argon2@0.45.1": true
  }
}
