{
  "name": "eino-backend",
  "version": "1.0.0",
  "description": "Book and movie tracker with web and Android clients",
  "author": "Jankku",
  "license": "MIT",
  "private": true,
  "main": "./dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && npx tsc",
    "start": "npm run build && node ./dist/src/app.js",
    "dev": "node -r ts-node/register --watch-path=src src/app.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write ./src",
    "migrate": "./node_modules/.bin/node-pg-migrate",
    "migrate:dev": "npx node-pg-migrate -m dist/migrations",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jankku/eino-backend.git"
  },
  "dependencies": {
    "@epic-web/cachified": "^5.6.2",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "@zxcvbn-ts/language-fi": "^3.0.2",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "close-with-grace": "^2.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.3",
    "luxon": "^3.7.2",
    "mailtrap": "^4.5.1",
    "multer": "^2.1.1",
    "node-pg-migrate": "^8.0.4",
    "otpauth": "^9.5.0",
    "pg-monitor": "^3.1.0",
    "pg-promise": "^12.6.2",
    "qrcode": "^1.5.4",
    "rfc4648": "^1.5.4",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "husky": "^9.1.7",
    "pin-github-action": "^3.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
