{
  "name": "eino-backend",
  "version": "1.0.0",
  "description": "Book and movie tracker with web and Android clients",
  "author": "Jankku",
  "license": "MIT",
  "private": true,
  "main": "./dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && npx tsc",
    "start": "npm run build && node ./dist/src/app.js",
    "dev": "node -r ts-node/register --watch-path=src src/app.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write ./src",
    "migrate": "./node_modules/.bin/node-pg-migrate",
    "migrate:dev": "npx node-pg-migrate -m dist/migrations",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jankku/eino-backend.git"
  },
  "dependencies": {
    "@epic-web/cachified": "^5.6.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fi": "^4.1.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "close-with-grace": "^2.5.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "mailtrap": "^5.0.0",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "otpauth": "^9.5.2",
    "pg-monitor": "^3.1.0",
    "pg-promise": "^12.7.1",
    "qrcode": "^1.5.4",
    "rfc4648": "^1.5.4",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "husky": "^9.1.7",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "pin-github-action": "^3.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "canvas@3.2.3": true,
    "@scarf/scarf": false,
    "unrs-resolver@1.12.2": true
  }
}
